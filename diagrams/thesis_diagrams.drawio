 battery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="220" height="80" as="geometry"/></mxCell><mxCell id="r2d" value="&lt;b&gt;Decision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBE0DC;strokeColor=#A8483A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="235" width="200" height="70" as="geometry"/></mxCell><mxCell id="r3t" value="&lt;b&gt;R3-known / R3-full&lt;/b&gt;&lt;br&gt;The model only&lt;br&gt;fills in a form" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="160" height="120" as="geometry"/></mxCell><mxCell id="r3in" value="Driver&amp;#x27;s sentence only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="425" width="220" height="70" as="geometry"/></mxCell><mxCell id="r3m" value="&lt;b&gt;Small model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="460" y="425" width="200" height="70" as="geometry"/></mxCell><mxCell id="r3s" value="&lt;b&gt;Form&lt;/b&gt;&lt;br&gt;goal, deadline, budget, wishes&lt;br&gt;(known: 3 kinds; full: all 7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="220" height="80" as="geometry"/></mxCell><mxCell id="r3p" value="&lt;b&gt;Exact planner&lt;/b&gt;&lt;br&gt;decides" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="425" width="200" height="70" as="geometry"/></mxCell><mxCell id="allref" value="&lt;b&gt;Every decision is&lt;/b&gt;&lt;br&gt;judged by the referee" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="200" height="90" as="geometry"/></mxCell><mxCell id="lg1" value="Done and tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="150" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="Ready, not yet run / planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="180" y="555" width="190" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r1in" target="r1m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" 