<mxfile host="app.diagrams.net" type="device"><diagram name="1 Study overview" id="1_Study_overview"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;The study at a glance&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="34" as="geometry"/></mxCell><mxCell id="osm" value="&lt;b&gt;Road network&lt;/b&gt;&lt;br&gt;Michigan, OpenStreetMap&lt;br&gt;56,923 road segments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCEAF7;strokeColor=#3B6E9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="230" height="70" as="geometry"/></mxCell><mxCell id="afdc" value="&lt;b&gt;Charging stations&lt;/b&gt;&lt;br&gt;AFDC export, Nov 2026&lt;br&gt;994 charger entries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCEAF7;strokeColor=#3B6E9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="230" height="70" as="geometry"/></mxCell><mxCell id="trips" value="&lt;b&gt;Real trips (validation)&lt;/b&gt;&lt;br&gt;DEVRT: Leaf e+, 2023&lt;br&gt;VED: Michigan, incl. winter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCEAF7;strokeColor=#3B6E9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="ref" value="&lt;b&gt;Referee&lt;/b&gt;&lt;br&gt;SUMO drives every option,&lt;br&gt;adds heating/cooling,&lt;br&gt;charging time and price,&lt;br&gt;checks every rule" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="250" height="120" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;DEVRT: +5.7% total energy&lt;br&gt;VED held-out: 0.99 ratio&lt;br&gt;(median trip error 15%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="250" height="90" as="geometry"/></mxCell><mxCell id="cases" value="&lt;b&gt;Test situations&lt;/b&gt;&lt;br&gt;1,400 generated, 300 kept&lt;br&gt;after testability checks&lt;br&gt;(Ann Arbor; Detroit = training)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="sheet" value="&lt;b&gt;What the model reads&lt;/b&gt;&lt;br&gt;fact sheet + the driver&amp;#x27;s sentence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="250" height="70" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;Small language models&lt;/b&gt;&lt;br&gt;Qwen2.5 0.5B / 1.5B / 3B&lt;br&gt;4-bit, on the laptop CPU&lt;br&gt;roles R1, R2, R3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="180" width="230" height="110" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;Baselines&lt;/b&gt;&lt;br&gt;goal-aware rule, nearest&lt;br&gt;to 80%, random safe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="300" width="250" height="80" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;Scoring vs. the referee&lt;/b&gt;&lt;br&gt;charge? (F1)&lt;br&gt;right charger (top-1)&lt;br&gt;target error, rules kept&lt;br&gt;optimality gap&lt;br&gt;time and memory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBE0DC;strokeColor=#A8483A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="230" height="140" as="geometry"/></mxCell><mxCell id="lora" value="&lt;b&gt;Adaptation&lt;/b&gt;&lt;br&gt;prompting and LoRA on the&lt;br&gt;Detroit training situations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="phone" value="&lt;b&gt;Deployment check&lt;/b&gt;&lt;br&gt;latency and memory on a phone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="250" height="70" as="geometry"/></mxCell><mxCell id="lg1" value="Done and tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="150" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="Ready, not yet run / planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="180" y="590" width="190" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="osm" target="ref"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="afdc" target="ref"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="trips" target="val"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="calibrates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="val" target="ref"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="labels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ref" target="cases"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cases" target="sheet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sheet" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sheet" target="base"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="llm" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="base" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="lora" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="phone" target="score"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Referee" id="2_Referee"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;How the referee finds the best answer for one situation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="34" as="geometry"/></mxCell><mxCell id="sit" value="&lt;b&gt;One situation&lt;/b&gt;&lt;br&gt;start, destination, time&lt;br&gt;battery %, outside temperature&lt;br&gt;driver&amp;#x27;s goal (fastest/cheapest)&lt;br&gt;optional deadline, budget&lt;br&gt;3 to 9 chargers near the route" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="260" height="150" as="geometry"/></mxCell><mxCell id="enum" value="&lt;b&gt;1. List every option&lt;/b&gt;&lt;br&gt;do not charge, or&lt;br&gt;charger × target 20-100%&lt;br&gt;(steps of 5%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="sumo" value="&lt;b&gt;2. Drive each leg in SUMO&lt;/b&gt;&lt;br&gt;start → charger → destination&lt;br&gt;Leaf e+ physics, real roads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="heat" value="&lt;b&gt;3. Add heating/cooling&lt;/b&gt;&lt;br&gt;226 W per °C below 12 °C&lt;br&gt;303 W per °C above 30 °C" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="230" height="100" as="geometry"/></mxCell><mxCell id="chg" value="&lt;b&gt;4. Charging time and cost&lt;/b&gt;&lt;br&gt;Level 2: 6.6 kW&lt;br&gt;DC: 50 kW, slower in the cold&lt;br&gt;and above 80%&lt;br&gt;listed or assumed price" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="210" width="230" height="120" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;5. Check every rule&lt;/b&gt;&lt;br&gt;plug fits, working, public&lt;br&gt;battery never below 10%&lt;br&gt;arrive by the deadline&lt;br&gt;stay within the budget" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="210" width="250" height="120" as="geometry"/></mxCell><mxCell id="rank" value="&lt;b&gt;6. Rank the valid options&lt;/b&gt;&lt;br&gt;fastest: earliest arrival&lt;br&gt;cheapest: lowest cost&lt;br&gt;→ best answer (and runner-up)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="250" height="120" as="geometry"/></mxCell><mxCell id="rob" value="&lt;b&gt;7. Robustness check&lt;/b&gt;&lt;br&gt;repeat with energy ±10%&lt;br&gt;and half the heating;&lt;br&gt;keep only if the best&lt;br&gt;answer stays the same" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="250" height="120" as="geometry"/></mxCell><mxCell id="keep" value="&lt;b&gt;Graded situation&lt;/b&gt;&lt;br&gt;answer stored with the full&lt;br&gt;table of options, so any&lt;br&gt;decision can be judged&lt;br&gt;(arrival, cost, rules broken)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="200" height="120" as="geometry"/></mxCell><mxCell id="drop" value="&lt;b&gt;Set aside as uncertain&lt;/b&gt;&lt;br&gt;the referee itself cannot be&lt;br&gt;sure (about 1 in 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sit" target="enum"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="enum" target="sumo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sumo" target="heat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="heat" target="chg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chg" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rules" target="rank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rank" target="rob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="stable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rob" target="keep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="answer flips" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rob" target="drop"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Roles" id="3_Roles"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Three ways to use the small model (research question 2)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="34" as="geometry"/></mxCell><mxCell id="r1t" value="&lt;b&gt;R1&lt;/b&gt;&lt;br&gt;The model&lt;br&gt;decides alone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="160" height="90" as="geometry"/></mxCell><mxCell id="r1in" value="Fact sheet +&lt;br&gt;driver&amp;#x27;s sentence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="r1m" value="&lt;b&gt;Small model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=