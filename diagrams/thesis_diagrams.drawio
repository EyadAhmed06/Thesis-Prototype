cing=6;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="380" height="30" as="geometry"/></mxCell><mxCell id="pick" value="&lt;b&gt;Pick a situation&lt;/b&gt;&lt;br&gt;(300 test situations)&lt;br&gt;and a request, or type one" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="200" height="90" as="geometry"/></mxCell><mxCell id="oll" value="&lt;b&gt;Ollama + Qwen2.5&lt;/b&gt;&lt;br&gt;4-bit, runs locally&lt;br&gt;role R1, R2 or R3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="220" height="90" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;On-device check (R2)&lt;/b&gt;&lt;br&gt;plug, status, access,&lt;br&gt;enough battery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="220" height="90" as="geometry"/></mxCell><mxCell id="ver" value="&lt;b&gt;Referee verdict and map&lt;/b&gt;&lt;br&gt;same grading code as the study:&lt;br&gt;pass, gap, the best option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBE0DC;strokeColor=#A8483A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="290" height="90" as="geometry"/></mxCell><mxCell id="json" value="&lt;b&gt;Stored SUMO drives&lt;/b&gt;&lt;br&gt;computed beforehand on the&lt;br&gt;Michigan road network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCEAF7;strokeColor=#3B6E9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="290" height="90" as="geometry"/></mxCell><mxCell id="time" value="&lt;b&gt;Shown on screen&lt;/b&gt;&lt;br&gt;what the model read, its answer,&lt;br&gt;time to decide" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="240" height="80" as="geometry"/></mxCell><mxCell id="lg1" value="Done and tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="150" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="Ready, not yet run / planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="190" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pick" target="oll"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="oll" target="chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chk" target="ver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="reason, one retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="chk" target="oll"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="json" target="ver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="oll" target="time"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 Adaptation" id="5_Adaptation"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Four ways to prepare the same small model (research question 3)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="34" as="geometry"/></mxCell><mxCell id="train" value="&lt;b&gt;Detroit training set&lt;/b&gt;&lt;br&gt;440 situations&lt;br&gt;only the 3 training wish kinds&lt;br&gt;every answer re-graded&lt;br&gt;by the referee: all correct" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="230" height="130" as="geometry"/></mxCell><mxCell id="none" value="&lt;b&gt;none&lt;/b&gt;&lt;br&gt;the plain instruction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="300" height="80" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;rules&lt;/b&gt;&lt;br&gt;plain instruction + a step-by-step&lt;br&gt;way to check a decision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="300" height="80" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;examples&lt;/b&gt;&lt;br&gt;the 2 training requests most like&lt;br&gt;the driver&amp;#x27;s words (TF-IDF),&lt;br&gt;with their correct answers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="300" height="90" as="geometry"/></mxCell><mxCell id="lora" value="&lt;b&gt;lora&lt;/b&gt;&lt;br&gt;fine-tuned once (QLoRA, r = 16,&lt;br&gt;2 epochs, 396 / 44 situations),&lt;br&gt;same 4-bit base model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="330" y="370" width="300" height="90" as="geometry"/></mxCell><mxCell id="test" value="&lt;b&gt;Ann Arbor test&lt;/b&gt;&lt;br&gt;300 situations&lt;br&gt;new roads, and 4 wish&lt;br&gt;kinds never seen&lt;br&gt;in training" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="220" height="130" as="geometry"/></mxCell><mxCell id="cmp" value="&lt;b&gt;Paired comparison&lt;/b&gt;&lt;br&gt;each condition vs none,&lt;br&gt;same model and role,&lt;br&gt;same situations&lt;br&gt;McNemar + Holm&lt;br&gt;(36 tests)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBE0DC;strokeColor=#A8483A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="960" y="190" width="200" height="150" as="geometry"/></mxCell><mxCell id="noleak" value="No test situation, answer or held-out wish kind is ever&lt;br&gt;shown to the model or used for retrieval or training" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="460" height="70" as="geometry"/></mxCell><mxCell id="lg1" value="Done and tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="150" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="Ready, not yet run / planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="180" y="510" width="190" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="train" target="ex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="train" target="lora"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="none" target="test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rules" target="test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ex" target="test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lora" target="test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test" target="cmp"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 Pipeline" id="6_Pipeline"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;The whole study with one command: python evbench.py run&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="34" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. Check inputs&lt;/b&gt;&lt;br&gt;maps, chargers,&lt;br&gt;trip data present" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCEAF7;strokeColor=#3B6E9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Validate referee&lt;/b&gt;&lt;br&gt;DEVRT and VED&lt;br&gt;real trips" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DFF0D8;strokeColor=#3C7A3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="185" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Build situations&lt;/b&gt;&lt;br&gt;check the frozen&lt;br&gt;fingerprint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEFD4;strokeColor=#A8741A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Baselines&lt;/b&gt;&lt;br&gt;5 fixed methods +&lt;br&gt;sensitivity check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="515" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Run models&lt;/b&gt;&lt;br&gt;roles, wordings,&lt;br&gt;adaptations, threads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EADCF5;strokeColor=#6E4A9E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6. Score&lt;/b&gt;&lt;br&gt;referee grading +&lt;br&gt;paired statistics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBE0DC;strokeColor=#A8483A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="845" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7. Report&lt;/b&gt;&lt;br&gt;one HTML page&lt;br&gt;with every table" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="80" width="145" height="110" as="geometry"/></mxCell><mxCell id="fp" value="Each stage stores SHA-256 fingerprints of what it read and wrote:&lt;br&gt;a stage whose inputs did not change is skipped; an interrupted&lt;br&gt;model run resumes where it stopped" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="540" height="80" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Live dashboard in the browser&lt;/b&gt;&lt;br&gt;each answer is graded the moment it arrives,&lt;br&gt;with the same referee code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBE0DC;strokeColor=#A8483A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="520" height="80" as="geometry"/></mxCell><mxCell id="lg1" value="Done and tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="150" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="Ready, not yet run / planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="180" y="360" width="190" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="s5" target="dash"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>